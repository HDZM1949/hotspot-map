# ===== 应用 =====
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ===== 数据库（PostgreSQL，嵌入式）=====
# 数据目录默认 <项目根>/.pgdata，一般无需修改
# DB_DATA_DIR=
# 数据库连接串（代码内置默认值：postgres://hotspot:hotspot@localhost:5432/hotspot_map）
# 可通过环境变量 DATABASE_URL 覆盖
DATABASE_URL=postgres://hotspot:hotspot@localhost:5432/hotspot_map

# ===== 采集器 =====
# 启用的数据源（逗号分隔）：gdelt / usgs / eonet
INGESTER_SOURCES=gdelt,usgs,eonet
# GDELT 增量文件根地址
GDELT_BASE_URL=https://data.gdeltproject.org/gdeltv2
# 若本机网络 HTTPS 被拦截导致数据源证书校验失败，
# 可设置环境变量 INGEST_TLS_BYPASS=1 跳过证书校验（仅限受信任的本地网络）
